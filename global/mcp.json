{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless", "--executable-path", "/usr/bin/chromium"],
      "protocol": "2025-11-25",
      "toolLoading": "deferred"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "protocol": "2025-11-25"
    }
  }
}
