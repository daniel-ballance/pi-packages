#!/usr/bin/env bash
# Local replacement for GitHub CI: run the root check before any push.
# Bypass with: git push --no-verify
set -euo pipefail

zero=0000000000000000000000000000000000000000
head="$(git rev-parse HEAD)"
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue   # branch deletions need no check
  pushing=1
  if [[ "$local_sha" != "$head" ]]; then
    echo "pre-push: pushing ${local_sha:0:7}, but HEAD is ${head:0:7}; the check runs on the working tree," >&2
    echo "pre-push: so check out what you push first (or git push --no-verify)." >&2
    exit 1
  fi
done
(( pushing )) || exit 0

if ! git diff --quiet HEAD --; then
  echo "pre-push: tracked files have uncommitted changes, so the check would not test what you push." >&2
  echo "pre-push: commit or stash them first (or git push --no-verify)." >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
log="$(mktemp -t pre-push-check.XXXXXX.log)"
echo "pre-push: running ./scripts/check.sh in $root (log: $log)" >&2
if "$root/scripts/check.sh" >"$log" 2>&1; then
  echo "pre-push: root check passed." >&2
  rm -f "$log"
else
  tail -30 "$log" >&2
  echo "pre-push: root check FAILED; push blocked. Full log: $log" >&2
  exit 1
fi
