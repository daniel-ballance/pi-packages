{
  "name": "pi-packages-repo",
  "private": true,
  "version": "0.0.0",
  "description": "Pi extensions and skills collection",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "workspaces": ["packages/*"],
  "devDependencies": { "brace-expansion": "5.0.12", "undici": "8.10.2" },
  "pi": {
    "extensions": [
      "./packages/claude-subscription/extensions/claude-subscription/index.ts",
      "./packages/computer-use/extensions/computer-use/index.ts",
      "./packages/mcp-client/extensions/mcp-client/index.ts",
      "./packages/pistack/extensions/pistack/index.ts",
      "./packages/self-reload/extensions/self-reload/index.ts",
      "./packages/subagents/extensions/subagents/index.ts",
      "./packages/todo/extensions/todo/index.ts",
      "./packages/web-search/extensions/web-search/index.ts"
    ],
    "skills": ["./packages/pi-pocock-skills/skills", "./packages/subagents/skills", "./packages/pistack/skills", "!./packages/pistack/skills/tdd"],
    "prompts": ["./packages/*/prompts/**/*.md"],
    "themes": ["./packages/*/themes/**/*.json"]
  },
  "scripts": {
    "check": "bash scripts/check.sh"
  }
}
