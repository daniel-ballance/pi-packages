{
  "name": "pi-packages-repo",
  "private": true,
  "version": "0.0.0",
  "description": "Pi extensions and skills collection",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "packages/p3stack/*",
    "scripts/lint-skill"
  ],
  "devDependencies": {
    "brace-expansion": "5.0.12",
    "undici": "8.12.2"
  },
  "scripts": {
    "check": "bash scripts/check.sh"
  },
  "piBundle": [
    "packages/claude-subscription",
    "packages/p3stack",
    "packages/computer-use",
    "packages/self-reload",
    "packages/web-search"
  ],
  "pi": {
    "extensions": [
      "./packages/claude-subscription/extensions/claude-subscription/index.ts",
      "./packages/p3stack/extensions/p3stack/index.ts",
      "./packages/p3stack/subagents/extensions/subagents/index.ts",
      "./packages/p3stack/todo/extensions/todo/index.ts",
      "./packages/computer-use/extensions/computer-use/index.ts",
      "./packages/self-reload/extensions/self-reload/index.ts",
      "./packages/web-search/extensions/web-search/index.ts"
    ],
    "skills": [
      "./packages/claude-subscription/skills",
      "./packages/p3stack/skills",
      "./packages/p3stack/subagents/skills",
      "./packages/computer-use/skills",
      "./packages/self-reload/skills",
      "./packages/web-search/skills"
    ],
    "prompts": [
      "./packages/claude-subscription/prompts/**/*.md",
      "./packages/p3stack/prompts/**/*.md",
      "./packages/computer-use/prompts/**/*.md",
      "./packages/self-reload/prompts/**/*.md",
      "./packages/web-search/prompts/**/*.md"
    ],
    "themes": [
      "./packages/claude-subscription/themes/**/*.json",
      "./packages/p3stack/themes/**/*.json",
      "./packages/computer-use/themes/**/*.json",
      "./packages/self-reload/themes/**/*.json",
      "./packages/web-search/themes/**/*.json"
    ]
  }
}
