{
  "name": "t3-subagents",
  "version": "0.1.0",
  "description": "Bounded T3-owned delegation for Pi, without native child processes",
  "type": "module",
  "keywords": [
    "pi-package",
    "subagents",
    "t3-code"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/t3-subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/**/*.md"
    ],
    "themes": [
      "./themes/**/*.json"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/node": "22.20.4",
    "tsx": "^4.21.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.3"
  }
}
