{
  "name": "p3stack",
  "version": "0.1.0",
  "description": "The Pi edition of Cursor's pstack: router mode, playbooks, principles and routed skills, generated from the vendored upstream and translated for Pi in a terminal and under T3 Code.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "skills"
  ],
  "files": [
    "extensions",
    "claude-subscription/package.json",
    "claude-subscription/extensions",
    "computer-use/package.json",
    "computer-use/extensions",
    "self-reload/package.json",
    "self-reload/extensions",
    "subagents/package.json",
    "subagents/extensions",
    "subagents/skills",
    "todo/package.json",
    "todo/extensions",
    "web-search/package.json",
    "web-search/extensions",
    "agents",
    "skills",
    "prompts",
    "themes",
    "AGENTS.md",
    "README.md",
    "LICENSE",
    "LICENSE-matt-pocock"
  ],
  "scripts": {
    "sync": "git -C ../.. submodule update --init packages/p3stack/vendor/pstack packages/p3stack/vendor/matt-pocock && node generator/generate.mjs",
    "generate": "node generator/generate.mjs",
    "bump": "node generator/update-upstream.mjs",
    "update-upstream": "node generator/update-upstream.mjs",
    "check": "node generator/generate.mjs --check && node generator/lint-hosts.mjs && node generator/check-t3-pin.mjs && node generator/lint-skills.mjs && tsc --noEmit -p skills/poteto-mode/scripts/watch-pr/tsconfig.json && tsc --noEmit -p tsconfig.json",
    "eval:routing": "node test/routing-eval/run.mjs",
    "test": "npm run test:once && T3_MCP_URL=http://127.0.0.1:1/mcp npm run test:once",
    "test:once": "node --test test/*.test.mjs test/*.test.ts && cd skills/poteto-mode/scripts && node --test check-plan.test.ts watch-pr/*.test.ts orch/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "cheerio": "^1.2.0",
    "commander": "15.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^26.6.5",
    "typebox": "^1.4.2",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./claude-subscription/extensions/claude-subscription/index.ts",
      "./computer-use/extensions/computer-use/index.ts",
      "./extensions/p3stack/index.ts",
      "./self-reload/extensions/self-reload/index.ts",
      "./subagents/extensions/subagents/index.ts",
      "./todo/extensions/todo/index.ts",
      "./web-search/extensions/web-search/index.ts"
    ],
    "skills": [
      "./skills",
      "./subagents/skills"
    ],
    "prompts": [
      "./prompts/**/*.md"
    ],
    "themes": [
      "./themes/**/*.json"
    ]
  },
  "p3stack": {
    "upstream": "cursor/plugins@88d47514b82e7c44f00f2b2a72ff6dd12158038c pstack 0.15.29"
  }
}
