{
  "name": "todo",
  "version": "0.1.0",
  "description": "Track task steps per Pi session branch, with a terminal widget and a progress status for RPC clients such as T3 Code.",
  "type": "module",
  "keywords": [
    "pi-package",
    "todo"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/todo/index.ts"
    ],
    "skills": ["./skills"],
    "prompts": ["./prompts/**/*.md"],
    "themes": ["./themes/**/*.json"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && T3_MCP_URL=http://127.0.0.1:1/mcp tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.6.1",
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@earendil-works/pi-tui": "^1.6.1",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2"
  }
}
