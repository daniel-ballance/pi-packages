{
  "model": "openai-codex/gpt-6-luna:medium",
  "timeoutSeconds": 900,
  "cases": [
    {
      "id": "floor-review",
      "about": "The review route runs floor-check, and the reply names the skipped test.",
      "fixture": "floor-review",
      "grant": "default",
      "prompt": "I've finished the sumAll change in this repo; it is uncommitted. Review my change before I open a PR. Do not commit, push, or open a PR.",
      "tools": "read,bash,grep,find,ls",
      "outcome": [
        { "id": "unchanged-tree", "kind": "unchanged" },
        { "id": "names-skipped-test", "kind": "skipped-test" }
      ],
      "process": [
        { "id": "ran-floor-check", "kind": "bash", "pattern": "^\\s*(?:cd\\s+[^;&|\\n]+\\s*&&\\s*)?(?:[A-Za-z_]\\w*=[^\\s;&|]*\\s+)*(?:[^\\s;&|\"'\\x60]*/)?node\\s+(?:\"[^\"\\n]*\\/floor-check\\.mjs\"|'[^'\\n]*\\/floor-check\\.mjs'|(?:[^\\s;&|\"'\\x60]*\\/)?floor-check\\.mjs)(?=\\s|$)", "diagnostic": "(?:^|\\n)skipped-test test/sum\\.test\\.js:13\\b|\"category\":\\s*\"skipped-test\",\\s*\"path\":\\s*\"test/sum\\.test\\.js\",\\s*\"line\":\\s*13\\b" }
      ]
    },
    {
      "id": "bug-red-first",
      "about": "A reported bug gets a red reproduction before the fix, a regression test, and a passing suite.",
      "fixture": "bug-red-first",
      "grant": "default",
      "prompt": "Customers say splitting a bill sometimes loses cents: splitting 1000 cents three ways only adds up to 999. Fix it.",
      "tools": "read,bash,edit,write,grep,find,ls",
      "outcome": [
        { "id": "bug-fixed", "kind": "oracle", "script": "split.mjs" },
        { "id": "suite-passes", "kind": "command", "run": "node --test" },
        { "id": "regression-test", "kind": "regression" }
      ],
      "process": [
        { "id": "read-diagnosing-bugs", "kind": "read", "pattern": "diagnosing-bugs/SKILL\\.md" },
        { "id": "test-command-before-edit", "kind": "order",
          "first": { "kind": "bash", "pattern": "^\\s*(?:cd\\s+[^;&|\\n]+\\s*&&\\s*)?(?:timeout\\s+\\d+(?:\\.\\d+)?[smhd]?\\s+)?(?:npx\\s+(?:--no-install\\s+)?)?(?:(?:[^\\s;&|\"'\\x60]*/)?node\\s+--test|npm\\s+(?:run\\s+)?test)(?=\\s|$)", "diagnostic": "(?:^|\\n)\\s*(?:AssertionError(?: \\[ERR_ASSERTION\\])?:|code:\\s*['\"]ERR_ASSERTION['\"])" },
          "before": { "kind": "edit", "pattern": "src/split\\.js" }
        }
      ]
    },
    {
      "id": "prototype-logic",
      "about": "A click-through request yields one self-contained HTML file a PM can open.",
      "fixture": "prototype-logic",
      "grant": "default",
      "prompt": "Before we build refunds, make something our PM can click through to try the refund states: requested, approved, rejected, and refunded. A partial refund can be approved more than once until the order is fully refunded.",
      "tools": "read,bash,edit,write,grep,find,ls,ask_user",
      "outcome": [
        { "id": "self-contained-prototype-responds", "kind": "file", "pattern": "\\.[Hh][Tt][Mm][Ll]$", "count": 1, "verifyPrototype": true }
      ],
      "process": [
        { "id": "read-interactive-prototype", "kind": "read", "pattern": "interactive-prototype/SKILL\\.md" }
      ]
    },
    {
      "id": "source-grounding",
      "about": "Version-sensitive framework config is grounded in fetched docs and cited.",
      "fixture": "source-grounding",
      "grant": "default",
      "mcp": true,
      "prompt": "Make the test run fail when line coverage drops below 80%, using Vitest's documented config for the version this project uses. Don't install anything.",
      "tools": "read,bash,edit,write,grep,find,ls,web_search,codemode,tool_search,mcp__*",
      "outcome": [
        { "id": "configured", "kind": "oracle", "script": "coverage.mjs" },
        { "id": "fetched-docs", "kind": "any", "of": [
          { "kind": "tool", "pattern": "^mcp__context7__query_docs$", "args": "vitest", "result": "coverage|thresholds" },
          { "kind": "bash", "pattern": "^\\s*(?:curl|wget)\\s+.*https?://(?:v3\\.)?vitest\\.dev/", "result": "coverage|thresholds" }
        ] },
        { "id": "cites-source", "kind": "final", "pattern": "https?://(?:(?:v3\\.)?vitest\\.dev|github\\.com/vitest-dev/vitest)(?:/|$|\\s)" }
      ],
      "process": [
        { "id": "versioned-docs", "kind": "any", "of": [
          { "kind": "tool", "pattern": "^mcp__context7__query_docs$", "args": "3[._]2" },
          { "kind": "final", "pattern": "3\\.2" }
        ] }
      ]
    }
  ]
}
