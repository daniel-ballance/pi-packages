{
  "sources": [
    {
      "name": "cursor-plugins",
      "vendor": "vendor/pstack/pstack",
      "map": [
        {
          "from": "skills/",
          "to": "skills/"
        },
        {
          "from": "agents/",
          "to": "agents/"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE"
        }
      ],
      "exclude": [
        "^skills/make-bot-ui/",
        "^skills/poteto-mode/scripts/(bootstrap\\.ts|bun\\.lock|package\\.json)$"
      ],
      "upstream": {
        "repository": "cursor/plugins",
        "checkout": "vendor/pstack",
        "branch": "main"
      }
    },
    {
      "name": "matt-pocock",
      "vendor": "vendor/matt-pocock",
      "map": [
        {
          "from": "skills/engineering/domain-modeling/GLOSSARY-FORMAT.md",
          "to": "skills/domain-modeling/CONTEXT-FORMAT.md"
        },
        {
          "from": "skills/engineering/",
          "to": "skills/"
        },
        {
          "from": "skills/productivity/",
          "to": "skills/"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE-matt-pocock"
        }
      ],
      "exclude": [
        "^skills/(engineering|productivity)/(?!(grilling|grill-with-docs|domain-modeling|codebase-design|code-review|writing-for-agents|diagnosing-bugs|research|wait-what|implement)/)",
        "^skills/[^/]+/[^/]+/agents/"
      ],
      "required": [
        "skills/grilling/SKILL.md",
        "skills/grill-with-docs/SKILL.md",
        "skills/domain-modeling/SKILL.md",
        "skills/codebase-design/SKILL.md",
        "skills/code-review/SKILL.md",
        "skills/writing-for-agents/SKILL.md",
        "skills/diagnosing-bugs/SKILL.md",
        "skills/research/SKILL.md",
        "skills/wait-what/SKILL.md",
        "skills/implement/SKILL.md"
      ],
      "upstream": {
        "repository": "mattpocock/skills",
        "checkout": "vendor/matt-pocock",
        "branch": "main"
      }
    }
  ]
}
