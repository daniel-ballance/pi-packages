{
  "registry": true,
  "sources": [
    {
      "name": "cursor-plugins",
      "vendor": "vendor/pstack/pstack",
      "skillRoots": ["skills/", "automations/"],
      "map": [
        {
          "from": "skills/",
          "to": "skills/"
        },
        {
          "from": "agents/",
          "to": "agents/"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE"
        }
      ],
      "exclude": [
        "^skills/poteto-mode/scripts/(bootstrap\\.ts|bun\\.lock|package\\.json)$",
        "^skills/statechart/scripts/test/"
      ],
      "upstream": {
        "repository": "cursor/plugins",
        "checkout": "vendor/pstack",
        "branch": "main"
      }
    },
    {
      "name": "matt-pocock",
      "vendor": "vendor/matt-pocock",
      "map": [
        {
          "from": "skills/engineering/",
          "to": "skills/"
        },
        {
          "from": "skills/productivity/",
          "to": "skills/"
        },
        {
          "from": "LICENSE",
          "to": "LICENSE-matt-pocock"
        }
      ],
      "exclude": [
        "^skills/[^/]+/[^/]+/agents/"
      ],
      "upstream": {
        "repository": "mattpocock/skills",
        "checkout": "vendor/matt-pocock",
        "branch": "main"
      }
    },
    {
      "name": "owner-plugins",
      "vendor": "vendor/pstack",
      "skillRoots": ["dyl-stack/skills/", "thermos/skills/"],
      "map": [
        { "from": "dyl-stack/skills/dyl-mode/SKILL.md", "to": "skills/dyl-mode/SKILL.md" },
        { "from": "dyl-stack/skills/dyl-mode/references/requirements.md", "to": "skills/dyl-mode/references/requirements.md" },
        { "from": "dyl-stack/skills/dyl-review/", "to": "skills/dyl-review/" },
        { "from": "thermos/skills/", "to": "skills/" },
        { "from": "thermos/agents/", "to": "agents/" }
      ],
      "upstream": {
        "repository": "cursor/plugins",
        "checkout": "vendor/pstack",
        "branch": "main"
      }
    }
  ]
}
