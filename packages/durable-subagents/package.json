{
  "name": "@daniel-ballance/durable-subagents",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent native Durable subagents hosted by a stable Pi extension",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "src",
    "README.md",
    "ARCHITECTURE.md",
    "dist"
  ],
  "scripts": {
    "check": "npm run build && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node --import tsx src/cli.ts smoke",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-durable": "1.0.0",
    "@earendil-works/chord": "1.0.0",
    "@durable-subagents/pi-ai": "npm:@earendil-works/pi-ai@1.0.0",
    "@durable-subagents/typebox": "npm:typebox@1.3.27"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "pi-host-1": "npm:@earendil-works/pi-coding-agent@1.0.0"
  },
  "pi": {
    "extensions": [
      "./extensions/durable-subagents/index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "keywords": [
    "pi-package",
    "subagents",
    "durable"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
