{
  "name": "subagents",
  "version": "0.3.0",
  "description": "Persistent RPC Pi children supervised by a parent-owned manager",
  "type": "module",
  "keywords": [
    "pi-package",
    "subagents"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "PEER-MESSAGING.md",
    "WORKFLOWS.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": ["./prompts/**/*.md"],
    "themes": ["./themes/**/*.json"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts && T3_MCP_URL=http://127.0.0.1:1/mcp tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": ">=1.3.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typebox": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
