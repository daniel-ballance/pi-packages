{
  "name": "subagents",
  "version": "0.3.0",
  "description": "Persistent RPC Pi children supervised by a parent-owned manager",
  "type": "module",
  "keywords": [
    "pi-package",
    "subagents"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "PEER-MESSAGING.md",
    "WORKFLOWS.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": ["./prompts/**/*.md"],
    "themes": ["./themes/**/*.json"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.99.2",
    "@earendil-works/pi-coding-agent": ">=0.99.2",
    "@earendil-works/pi-tui": ">=0.99.2",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.99.2",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.3"
  }
}
