{
  "name": "claude-subscription",
  "version": "0.1.0",
  "description": "Claude models for Pi through the Claude Agent SDK and your Claude subscription",
  "type": "module",
  "keywords": [
    "pi-package",
    "provider",
    "claude",
    "claude-agent-sdk"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/claude-subscription/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts/**/*.md"
    ],
    "themes": [
      "./themes/**/*.json"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:live": "tsx --test test/live/*.live.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.3.0",
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
