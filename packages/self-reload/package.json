{
  "name": "self-reload",
  "version": "0.1.0",
  "description": "Agent-requested Pi runtime reload with automatic continuation",
  "type": "module",
  "keywords": ["pi-package", "reload"],
  "files": ["extensions", "skills", "prompts", "themes", "README.md"],
  "pi": {
    "extensions": ["./extensions/self-reload/index.ts"],
    "skills": ["./skills"],
    "prompts": ["./prompts/**/*.md"],
    "themes": ["./themes/**/*.json"]
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typebox": "^1.4.6"
  }
}
