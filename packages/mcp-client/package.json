{
  "name": "mcp-client",
  "version": "0.1.0",
  "description": "MCP client for Pi: initialization-based and 2026-07-28 protocols",
  "type": "module",
  "keywords": [
    "pi-package",
    "mcp"
  ],
  "files": [
    "extensions",
    "skills",
    "prompts",
    "themes",
    "README.md",
    "CONFORMANCE.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/mcp-client/index.ts"
    ],
    "skills": ["./skills"],
    "prompts": ["./prompts/**/*.md"],
    "themes": ["./themes/**/*.json"]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "format:check": "prettier --check extensions test README.md CONFORMANCE.md",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eventsource-parser": "^3.0.6",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.0.0",
    "prettier": "3.6.2",
    "tsx": "^4.21.0",
    "typebox": "^1.0.0",
    "typescript": "^5.9.3"
  }
}
