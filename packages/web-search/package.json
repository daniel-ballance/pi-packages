{
  "name": "web-search",
  "version": "0.1.0",
  "description": "Zero-configuration DuckDuckGo web search for Pi",
  "type": "module",
  "keywords": ["pi-package", "web-search", "duckduckgo"],
  "files": ["extensions", "skills", "prompts", "themes", "README.md"],
  "pi": {
    "extensions": ["./extensions/web-search/index.ts"],
    "skills": ["./skills"],
    "prompts": ["./prompts/**/*.md"],
    "themes": ["./themes/**/*.json"]
  },
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": { "cheerio": "^1.2.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typebox": "^1.0.0"
  }
}
